{
	"name": "@baget/core",
	"version": "0.0.1",
	"description": "A decorator-driven framework on top of Elysia. Decorators, dependency injection, schema validation. Runs on Bun and Cloudflare Workers.",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md", "LICENSE"],
	"scripts": {
		"build": "rm -rf dist && bun run build:js && bun run build:types",
		"build:js": "bun build ./src/index.ts --outdir ./dist --target node --format esm --external elysia --external 'elysia/*' --external reflect-metadata --external @sinclair/typebox",
		"build:types": "tsc -p tsconfig.build.json",
		"prepublishOnly": "bun run build"
	},
	"keywords": [
		"elysia",
		"framework",
		"decorators",
		"dependency-injection",
		"di",
		"typescript",
		"bun",
		"cloudflare-workers",
		"api",
		"rest",
		"typebox",
		"validation"
	],
	"author": "Thomas POYETON",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/thomaspoyeton/baget.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/thomaspoyeton/baget#readme",
	"bugs": {
		"url": "https://github.com/thomaspoyeton/baget/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@types/bun": "latest"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"elysia": "^1.4.28",
		"reflect-metadata": "^0.2.2"
	}
}
